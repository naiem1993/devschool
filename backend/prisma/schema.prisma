generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
//  CATEGORY (বিন্যাস)
// ==========================================
model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  icon        String?   // emoji বা SVG আইকন
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tutorials   Tutorial[]
  references  Reference[]

  @@index([slug]) // ক্যাটাগরি পেজের জন্য slug দিয়ে সার্চ
  @@index([isActive, sortOrder]) // সক্রিয় ক্যাটাগরি সাজাতে
}

// ==========================================
//  TUTORIAL (টিউটোরিয়াল)
// ==========================================
model Tutorial {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String?
  difficulty   String   @default("beginner") // beginner, intermediate, advanced
  viewCount    Int      @default(0)
  isActive     Boolean  @default(true)
  duration     Int?
  rating       Float?
  isPublished  Boolean  @default(false)
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contents     TutorialContent[]
  quizzes      QuizQuestion[]
  challenges   CodeChallenge[]

  @@index([slug]) // টিউটোরিয়াল ডিটেইল পেজে slug ব্যবহার
  @@index([categoryId, createdAt]) // ক্যাটাগরি অনুযায়ী টিউটোরিয়াল লিস্টিং + সাজানো
  @@index([isPublished])
}

// ==========================================
//  TUTORIALCONTENT (অধ্যায়ভিত্তিক কনটেন্ট)
// ==========================================
model TutorialContent {
  id           String   @id @default(cuid())
  tutorialId   String
  tutorial     Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  chapterNo    Int
  title        String
  content      String   // Markdown বা HTML
  codeExample  String?  // ঐচ্ছিক কোড ব্লক
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tutorialId, chapterNo])
  @@index([tutorialId, chapterNo]) // অধ্যায় অনুযায়ী দ্রুত আনতে
}

// ==========================================
//  QUIZQUESTION (কুইজ প্রশ্ন)
// ==========================================
model QuizQuestion {
  id           String   @id @default(cuid())
  tutorialId   String
  tutorial     Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  question     String
  explanation  String?  // কেন এই উত্তর সঠিক
  orderIndex   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  options      QuizOption[]

  @@index([tutorialId]) // টিউটোরিয়ালের কুইজ আনতে
}

model QuizOption {
  id          String   @id @default(cuid())
  questionId  String
  question    QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text        String
  isCorrect   Boolean  @default(false)
  optionOrder Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([questionId])
}

// ==========================================
//  CODECHALLENGE (কোড চ্যালেঞ্জ)
// ==========================================
model CodeChallenge {
  id           String   @id @default(cuid())
  tutorialId   String
  tutorial     Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  title        String
  description  String
  starterCode  String?  // প্রাথমিক কোড টেমপ্লেট
  solution     String?  // রেফারেন্স সলিউশন
  difficulty   String   @default("Easy")
  points       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  testCases    TestCase[]

  @@index([tutorialId])
}

model TestCase {
  id             String   @id @default(cuid())
  challengeId    String
  challenge      CodeChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  input          String   // JSON ফরম্যাটে
  expectedOutput String
  isHidden       Boolean  @default(false) // ইউজারের কাছ থেকে দেখাবে না
  testCaseOrder  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([challengeId])
}

// ==========================================
//  REFERENCE (রেফারেন্স / ডিকশনারি)
// ==========================================
model Reference {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title       String
  slug        String   @unique
  description String?
  syntax      String?  // ফাংশন সিনট্যাক্স
  example     String?
  tags        String[] // PostgreSQL Array টাইপ
  language    String?  // programming language
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug]) // রেফারেন্স ডিটেইল পেজ
  @@index([categoryId])
}

// ==========================================
//  DONATION (দান সংক্রান্ত তথ্য)
// ==========================================
model Donation {
  id            String   @id @default(cuid())
  amount        Float
  currency      String   @default("BDT")
  donorName     String?
  donorEmail    String?
  transactionId String?  @unique
  status        String   @default("pending") // pending, completed, failed
  message       String?
  isPublic      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status]) // রিপোর্ট ও ফিল্টারিং
  @@index([createdAt])
}

// ==========================================
//  SITESETTINGS (অ্যাডমিন কনফিগারেশন)
// ==========================================
model SiteSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json     // JSONB টাইপ, যেকোনো ডেটা স্টোর করতে পারে
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
