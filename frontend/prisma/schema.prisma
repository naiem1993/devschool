generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
//  CATEGORY (বিষয়)
// ==========================================
model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  icon        String?   // emoji বা SVG আইকন
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tutorials   Tutorial[]
  references  Reference[]

  @@index([slug])
  @@index([isActive, sortOrder])
}

// ==========================================
//  TUTORIAL (টিউটোরিয়াল)
// ==========================================
model Tutorial {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String?
  difficulty   String   @default("beginner")
  viewCount    Int      @default(0)
  isActive     Boolean  @default(true)
  duration     Int?     // 时长（分钟）
  rating       Float?   // 评分
  isPublished  Boolean  @default(false)
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contents     TutorialContent[]
  quizzes      QuizQuestion[]
  challenges   CodeChallenge[]

  @@index([slug])
  @@index([categoryId, createdAt])
  @@index([isPublished])
}

// ==========================================
//  TUTORIALCONTENT (অধ্যায়ভিত্তিক কন্টেন্ট)
// ==========================================
model TutorialContent {
  id           String   @id @default(cuid())
  tutorialId   String
  tutorial     Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  chapterNo    Int
  title        String
  content      String   // Markdown বা HTML
  codeExample  String?  // ঐচ্ছিক কোড ব্লক
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tutorialId, chapterNo])
  @@index([tutorialId, chapterNo])
}

// ==========================================
//  QUIZQUESTION (কুইজ প্রশ্ন)
// ==========================================
model QuizQuestion {
  id           String   @id @default(cuid())
  tutorialId   String
  tutorial     Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  question     String
  explanation  String?
  orderIndex   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  options      QuizOption[]

  @@index([tutorialId])
}

model QuizOption {
  id          String   @id @default(cuid())
  questionId  String
  question    QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text        String
  isCorrect   Boolean  @default(false)
  optionOrder Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([questionId])
}

// ==========================================
//  CODECHALLENGE (কোড চ্যালেঞ্জ)
// ==========================================
model CodeChallenge {
  id           String   @id @default(cuid())
  tutorialId   String
  tutorial     Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  title        String
  description  String
  starterCode  String?
  solution     String?
  difficulty   String   @default("Easy")
  points       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  testCases    TestCase[]

  @@index([tutorialId])
}

model TestCase {
  id             String   @id @default(cuid())
  challengeId    String
  challenge      CodeChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  input          String
  expectedOutput String
  isHidden       Boolean  @default(false)
  testCaseOrder  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([challengeId])
}

// ==========================================
//  REFERENCE (রেফারেন্স / ডিকশনারি)
// ==========================================
model Reference {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title       String
  slug        String   @unique
  description String?
  syntax      String?
  example     String?
  tags        String[]
  language    String?  //programming language
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([categoryId])
}

// ==========================================
//  DONATION (দান সংক্রান্ত তথ্য)
// ==========================================
model Donation {
  id            String   @id @default(cuid())
  amount        Float
  currency      String   @default("BDT")
  donorName     String?
  donorEmail    String?
  transactionId String?  @unique
  status        String   @default("pending")
  message       String?
  isPublic      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ==========================================
//  SITESETTINGS (অ্যাডমিন কনফিগারেশন)
// ==========================================
model SiteSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
