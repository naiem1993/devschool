generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
//  CATEGORY (বিষয়)
// ==========================================
model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  icon        String?
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tutorials   Tutorial[]
  references  Reference[]

  @@index([slug])
  @@index([isActive, sortOrder])
}

// ==========================================
//  TUTORIAL
// ==========================================
model Tutorial {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String?
  difficulty   String   @default("beginner")
  viewCount    Int      @default(0)
  isActive     Boolean  @default(true)
  duration     Int?
  rating       Float?
  isPublished  Boolean  @default(false)
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  groups       ChapterGroup[]
  chapters     Chapter[]
  quizzes      QuizQuestion[]
  challenges   CodeChallenge[]

  @@index([slug])
  @@index([categoryId, createdAt])
  @@index([isPublished])
}

// ==========================================
//  CHAPTERGROUP — sidebar-এর non-clickable section header
//  e.g. "HTML Forms", "HTML Graphics"
//  কোনো URL নেই, কোনো caret নেই — শুধু visual divider
// ==========================================
model ChapterGroup {
  id         String   @id @default(cuid())
  tutorialId String
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  title      String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  chapters   Chapter[]

  @@index([tutorialId, sortOrder])
}

// ==========================================
//  CHAPTER — sidebar-এর main item
//  দুই ধরনের:
//   (ক) single-page — lessons[] খালি, content নিজের
//   (খ) nested       — lessons[] আছে, content null
//  URL: lowest-sortOrder lesson = /{chapter.slug}
//       বাকি lesson             = /{chapter.slug}/{lesson.slug}
// ==========================================
model Chapter {
  id          String        @id @default(cuid())
  tutorialId  String
  tutorial    Tutorial      @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  groupId     String?
  group       ChapterGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  title       String
  slug        String
  sortOrder   Int           @default(0)

  // শুধু single-page chapter-এর জন্য (nested হলে null)
  content     String?
  codeExample String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lessons     Lesson[]

  @@unique([tutorialId, slug])
  @@index([tutorialId, sortOrder])
  @@index([groupId])
}

// ==========================================
//  LESSON — nested chapter-এর ভেতরের item
//  slug শুধু chapter-এর ভেতরে unique
// ==========================================
model Lesson {
  id          String   @id @default(cuid())
  chapterId   String
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  title       String
  slug        String
  content     String
  codeExample String?
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([chapterId, slug])
  @@index([chapterId, sortOrder])
}

// ==========================================
//  QUIZQUESTION
// ==========================================
model QuizQuestion {
  id           String   @id @default(cuid())
  tutorialId   String
  tutorial     Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  question     String
  explanation  String?
  orderIndex   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  options      QuizOption[]
  attempts     QuizAttempt[]

  @@index([tutorialId])
}

model QuizOption {
  id          String   @id @default(cuid())
  questionId  String
  question    QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text        String
  isCorrect   Boolean  @default(false)
  optionOrder Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([questionId])
}

// ==========================================
//  CODECHALLENGE
// ==========================================
model CodeChallenge {
  id           String   @id @default(cuid())
  tutorialId   String
  tutorial     Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  title        String
  description  String
  starterCode  String?
  solution     String?
  difficulty   String   @default("Easy")
  points       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  testCases    TestCase[]
  attempts     ChallengeAttempt[]

  @@index([tutorialId])
}

model TestCase {
  id             String   @id @default(cuid())
  challengeId    String
  challenge      CodeChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  input          String
  expectedOutput String
  isHidden       Boolean  @default(false)
  testCaseOrder  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([challengeId])
}

// ==========================================
//  REFERENCE
// ==========================================
model Reference {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title       String
  slug        String   @unique
  description String?
  syntax      String?
  example     String?
  tags        String[]
  language    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([categoryId])
}

// ==========================================
//  DONATION
// ==========================================
model Donation {
  id            String   @id @default(cuid())
  amount        Float
  currency      String   @default("BDT")
  donorName     String?
  donorEmail    String?
  transactionId String?  @unique
  status        String   @default("pending")
  message       String?
  isPublic      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ==========================================
//  SITESETTINGS
// ==========================================
model SiteSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
//  REVIEW — ইউজারের দেওয়া feedback (admin approve করলে homepage-এ দেখাবে)
// ==========================================
model Review {
  id        String   @id @default(cuid())
  name      String
  role      String?
  stars     Int      @default(5)
  text      String
  status    String   @default("pending") // pending | approved
  deviceId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// ==========================================
//  REVIEWCOOLDOWN — ১ device ৩০ দিনে মাত্র ১বার review দিতে পারবে
//  (review delete হলেও cooldown টিকে থাকে, তাই bypass হয় না)
// ==========================================
model ReviewCooldown {
  id             String   @id @default(cuid())
  deviceId       String   @unique
  lastSubmittedAt DateTime @default(now())

  @@index([deviceId])
}

// ==========================================
//  ADMINUSER — email + password auth (bcrypt)
// ==========================================
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
}

// ==========================================
//  QUIZATTEMPT — anonymous progress tracking
// ==========================================
model QuizAttempt {
  id            String   @id @default(cuid())
  deviceId      String
  questionId    String
  question      QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedId    String?
  isCorrect     Boolean
  timeTakenSec  Int?
  createdAt     DateTime @default(now())

  @@index([deviceId, createdAt])
  @@index([deviceId, questionId])
  @@index([questionId])
}

// ==========================================
//  CHALLENGEATTEMPT — anonymous progress tracking
// ==========================================
model ChallengeAttempt {
  id             String   @id @default(cuid())
  deviceId       String
  challengeId    String
  challenge      CodeChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  passed         Boolean
  passedCount    Int      @default(0)
  totalCount     Int      @default(0)
  codeSubmitted  String?
  timeTakenSec   Int?
  createdAt      DateTime @default(now())

  @@index([deviceId, createdAt])
  @@index([deviceId, challengeId])
  @@index([challengeId])
}

// ==========================================
//  PINLOCKOUT — singleton row for delete-PIN lockout state
//  PIN নিজে env var-এ (ADMIN_PIN), কিন্তু attempt/lock state DB-তে
//  রাখতে হয়, কারণ env var runtime-এ লেখা যায় না।
//  Manual unlock: Supabase Studio → PinLockout → lockedUntil = null
// ==========================================
model PinLockout {
  id             String    @id @default("singleton")
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt
}

// ==========================================
//  SPONSORIMAGE — image blob store (DB-blob mode)
//  ছবি byte আকারে Postgres-এ রাখা হয়। hash দিয়ে dedup —
//  একই ছবি দুইবার upload করলে দ্বিতীয়বার save হয় না,
//  শুধু existing row-এর id reuse হয়।
//  একই SponsorImage একাধিক Sponsor-এ reference করা যায়।
// ==========================================
model SponsorImage {
  id        String    @id @default(cuid())
  hash      String    @unique
  mimeType  String
  width     Int?
  height    Int?
  sizeBytes Int
  data      Bytes
  createdAt DateTime  @default(now())

  sponsors  Sponsor[]

  @@index([hash])
}

// ==========================================
//  SPONSOR — sponsor/partner listing
//  logoUrl = '/api/sponsors/image/[imageId]' (upload mode)
//          অথবা সরাসরি external URL (URL paste mode)
//  imageId → SponsorImage (upload mode-এ FK, external-এ null)
//  websiteUrl = sponsor logo-তে ক্লিক করলে যেখানে যাবে
// ==========================================
model Sponsor {
  id          String        @id @default(cuid())
  name        String
  logoUrl     String?
  imageId     String?
  image       SponsorImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  websiteUrl  String?
  description String?
  tier        String        @default("partner") // gold | silver | bronze | partner
  priority    Int           @default(0)
  isActive    Boolean       @default(true)
  startDate   DateTime?
  endDate     DateTime?
  impressions Int           @default(0)
  clicks      Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isActive, priority])
  @@index([imageId])
}
